{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "Preserve the TypeScript 6 compiler API required by svelte-check.",
      "matchManagers": ["npm"],
      "matchFileNames": ["web/package.json"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
