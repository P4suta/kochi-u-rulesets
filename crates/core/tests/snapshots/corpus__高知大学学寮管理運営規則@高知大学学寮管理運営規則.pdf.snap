    {
      "ordinal": 10,
      "heading_raw": "附  則（令和３年３月30日規則第68号）",
      "amendment": {
        "number": 68,
        "year": null,
        "raw": "規則第68号"
      },
      "promulgated": {
        "era": "reiwa",
        "year": 3,
